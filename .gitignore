# Dependencies and generated outputs
node_modules/
.venv/
backend/.venv/
backend/.playwright-browsers/
__pycache__/
*.py[cod]
.pytest_cache/
backend/build/
backend/dist/
/dist/
/out/
frontend/main-deck/dist/

# Private local state and development evidence
/.claude/
/.codex/
/artifacts/
/attachments/
/data/
/backend/data/
/logs/
/tmp/
/.tmp*/
/tmp-*/
/backend/tmp*/
/terminals/
/runtimes/
.env
.env.*
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
