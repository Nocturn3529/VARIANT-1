*.jsonl

# Only reviewed default config belongs in source control
/config/*
!/config/native-runtime.json
!/config/llm_config.default.json
!/config/messaging.default.json
!/config/tools.default.json
!/config/TOOLS.md
!/config/prompts/
!/config/searxng/
!/config/plugins/
/config/plugins/*
!/config/plugins/.gitkeep

# Native binaries, model weights, and optional licensed avatar components
/bin/
/models/*
!/models/speech/
/models/speech/*
!/models/speech/README.txt
/assets/avatar/*
!/assets/avatar/README.md
/frontend/vendor/*
!/frontend/vendor/README.md
/experiments/live-canary/runs/

# OS/editor files
.DS_Store
Thumbs.db
*.spec.bak
