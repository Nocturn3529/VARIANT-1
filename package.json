{
  "name": "variant1",
  "version": "0.1.1-preview.1",
  "description": "VARIANT-1 \u2014 a local-first, model-agnostic Adaptive AI Host",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run build:deck && electron .",
    "dev": "npm run build:deck && electron . --enable-logging",
    "dev:deck": "node scripts/build-deck.js --watch",
    "build:deck": "node scripts/build-deck.js",
    "setup:backend": "node scripts/setup-backend.js",
    "test:python": "node scripts/test-python.js",
    "test:python:desktop": "node scripts/test-python.js --desktop",
    "test:deck:e2e": "npm run build:deck && node scripts/test-browser-retained-native.js && node scripts/test-native-popouts-electron.js && node scripts/test-pdf-preview-electron.js && node scripts/test-browser-host-native.js && node scripts/test-terminal-selection-electron.js && node scripts/test-browser-downloads-native.js && node scripts/test-browser-keys-native.js && node scripts/test-browser-wrapped-click-native.js && node scripts/test-browser-element-refs-native.js && node scripts/test-chat-ownership-native.js && node scripts/test-composer-native.js && node scripts/test-chat-windows-native.js",
    "test:backend:frozen": "node scripts/test-frozen-backend-smoke.js",
    "test:kernel:frozen": "node scripts/test-frozen-kernel-smoke.js",
    "test:astb:frozen": "node scripts/test-frozen-kernel-smoke.js --astb",
    "test:native:packaged": "node scripts/test-packaged-native-runtime.js",
    "test:frozen": "npm run test:backend:frozen && npm run test:kernel:frozen",
    "test:frontend": "node scripts/test-frontend.js",
    "build:backend": "node scripts/build-backend.js",
    "dist": "npm run build:deck && npm run build:backend && electron-builder",
    "dist:electron-only": "electron-builder",
    "test": "node scripts/test.js",
    "clean:artifacts": "node scripts/clean-artifacts.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "0.25.9",
    "jsdom": "26.1.0",
    "p5": "2.3.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2"
  },
  "build": {
    "appId": "app.variant1.desktop",
    "productName": "VARIANT-1",
    "files": [
      "main.js",
      "electron-*.js",
      "deck-preload.js",
      "chat-preload.js",
      "monitor-preload.js",
      "popout-preload.js",
      "deck-routes.json",
      "THIRD_PARTY_NOTICES.md",
      "frontend/**/*",
      "!frontend/main-deck/src/**/*",
      "!frontend/main-deck/dev/**/*",
      "!frontend/main-deck/tsconfig.json",
      "!frontend/main-deck/dist/*.map",
      "!frontend/main-deck/dist/**/*.map",
      "!frontend/main-deck/dist/fixture.js",
      "!frontend/main-deck/dist/fixture.js.map",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "llama-server.exe",
          "llama-server-impl.dll",
          "llama-common.dll",
          "llama.dll",
          "mtmd.dll",
          "ggml.dll",
          "ggml-base.dll",
          "ggml-cpu-*.dll",
          "ggml-cuda.dll",
          "ggml-rpc.dll",
          "libomp140.x86_64.dll",
          "cublas64_13.dll",
          "cublasLt64_13.dll",
          "cudart64_13.dll"
        ]
      },
      {
        "from": "config",
        "to": "config",
        "filter": [
          "llm_config.default.json",
          "messaging.default.json",
          "prompts/**/*",
          "searxng/**/*",
          "tools.default.json",
          "TOOLS.md"
        ]
      },
      {
        "from": "backend/dist/Variant1Backend",
        "to": "backend"
      },
      {
        "from": "backend/dist/Variant1Kernel",
        "to": "backend/kernel"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/tray/icon_256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": ""
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nocturn3529/VARIANT-1.git"
  },
  "bugs": {
    "url": "https://github.com/Nocturn3529/VARIANT-1/issues"
  },
  "homepage": "https://variant-1-silk.vercel.app/"
}
